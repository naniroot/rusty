{
  "permissions": {
    "deny": [
      "Edit(**/*.rs)",
      "Write(**/*.rs)",
      "Edit(**/Cargo.toml)",
      "Write(**/Cargo.toml)"
    ],
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(cargo tree:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}

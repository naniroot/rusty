{
  "permissions": {
    "deny": [
      "Bash(cargo:*)",
      "Bash(rustup:*)",
      "Bash(rustc:*)",
      "Bash(rustfmt:*)",
      "Edit(**/*.rs)",
      "Write(**/*.rs)",
      "Edit(**/Cargo.toml)",
      "Write(**/Cargo.toml)"
    ],
    "ask": [
      "Edit(**)",
      "Write(**)",
      "NotebookEdit(**)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
